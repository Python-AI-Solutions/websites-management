# AWS Terraform Variables - Security Hardening Configuration
#
# IMPORTANT: Copy this file to aws.tfvars and update the values
# then run: tofu apply -var-file=aws.tfvars
#
# These values restrict access to the bastion jump host for security hardening

# ============================================================================
# SECURITY FIX #1: SSH CIDR Restriction (Port 22)
# ============================================================================
#
# BEFORE (Insecure): SSH open to 0.0.0.0/0 (entire internet)
# AFTER (Secure):    SSH restricted to WireGuard VPN + 2 emergency IPs
#
# This variable controls who can SSH to the bastion jump host on port 22
#
# Value explanation:
#   - 10.99.0.0/24     = WireGuard VPN subnet (primary access)
#   - 109.76.78.109/32 = John's home IP (emergency fallback)
#   - 223.190.84.183/32= User's home IP (emergency fallback)
#
jump_host_ssh_cidrs = [
  "10.99.0.0/24",      # WireGuard VPN - primary access method
  "109.76.78.109/32",  # John's home (emergency only if WireGuard breaks)
  "223.190.84.183/32"  # User's home (emergency only if WireGuard breaks)
]

# ============================================================================
# SECURITY FIX #2: Port 7005 FRP Fallback (Emergency SSH Only)
# ============================================================================
#
# BEFORE (Insecure): FRP port 7005 open to 0.0.0.0/0 (entire internet)
# AFTER (Secure):    FRP port 7005 restricted to WireGuard VPN only
#
# This is an EMERGENCY-ONLY fallback if WireGuard VPN is misconfigured
# Two-hop security: FRP key + SSH key required to access k8s host
#
# Value explanation:
#   - 10.99.0.0/24 = WireGuard VPN subnet ONLY (no internet access)
#
# For detailed emergency procedure, see: aws/runbooks/FRP_EMERGENCY_ACCESS.md
#
jump_host_port_7005_cidrs = [
  "10.99.0.0/24"  # WireGuard VPN only - emergency fallback access
]

# ============================================================================
# Other variables (optional - most have sensible defaults)
# ============================================================================
# These are already configured with defaults in variables.tf
# Only override if you need to change existing infrastructure:

# aws_region = "us-east-1"
# jump_host_instance_type = "t2.micro"
# jump_host_root_volume_size = 30
# jump_host_root_volume_iops = 3000
# jump_host_root_volume_throughput = 125

# ============================================================================
# NOTES FOR JOHN
# ============================================================================
#
# 1. CREATE FILE:
#    cp aws.tfvars.example aws.tfvars
#
# 2. VERIFY VALUES:
#    - SSH CIDR: Should include 10.99.0.0/24 (WireGuard) + your 2 emergency IPs
#    - Port 7005: Should be 10.99.0.0/24 ONLY (emergency fallback, WireGuard restricted)
#
# 3. RUN TERRAFORM:
#    cd aws
#    tofu plan -var-file=aws.tfvars     # Review what will change
#    tofu apply -var-file=aws.tfvars    # Apply changes (~1.5 hours total)
#
# 4. WHAT THIS CHANGES:
#    ✅ SSH restricted from 0.0.0.0/0 to 10.99.0.0/24 + 2 emergency IPs
#    ✅ Port 7005 restricted from 0.0.0.0/0 to 10.99.0.0/24 (emergency fallback)
#    ✅ Egress rules explicit (DNS/HTTPS/HTTP - no catch-all to 0.0.0.0/0)
#    ✅ WireGuard peer key rotated
#
# 5. AWS CREDENTIALS:
#    Make sure these environment variables are set before running tofu:
#    export AWS_ACCESS_KEY_ID="your_access_key"
#    export AWS_SECRET_ACCESS_KEY="your_secret_key"
#    export AWS_REGION="us-east-1"
#
# 6. TIME ESTIMATE:
#    tofu plan: 2-3 minutes
#    tofu apply: ~1.5 hours (mostly waiting for AWS to provision)
#
# For questions, see: MESSAGE_FOR_JOHN.md or REPLY_TO_JOHN_CONCISE.md
