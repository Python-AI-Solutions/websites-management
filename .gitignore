# Environment files
.env
.env.local

# Terraform/OpenTofu files
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
.tofu-cache/
terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kubernetes files
kubeconfig
*.kubeconfig
k8s/kubeconfig
k8s/tmp-*
k8s/join-command.txt

# Remote state setup (bootstrap)
k8s/remote-state-setup/terraform.tfstate
k8s/remote-state-setup/terraform.tfstate.backup
k8s/remote-state-setup/.terraform/

# Python
__pycache__/
.pixi/
.venv/
pixi.lock

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# SSH keys (security)
*.pem
*.key
id_rsa*
id_ed25519*

# GCP service account credentials (security)
*-gcs-admin-*.json
platform-cluster-admin-*.json

# WireGuard private keys (security)
k8s/debian-wireguard-keys.md
*.conf                          # WireGuard config files with private keys
~/.config/wireguard/            # User's WireGuard configs
sumit.conf                      # User-specific WireGuard config files
*-wireguard-keys.md             # Any WireGuard key files

# Environment configurations - NEVER commit production secrets
envs/*.tfvars
!envs/*.tfvars.example
