namespace = "argocd"

app_projects = {
  platform = {
    description = "Platform-managed workloads"
    source_repos = [
      "https://github.com/pythonaisolutions/agentic-cervical-screener.git"
    ]
    destinations = [
      { namespace = "production" },
      { namespace = "staging" }
    ]
  }
}

applications = {
  cervical_viewer_prod = {
    project = "platform"
    source = {
      repo_url        = "https://github.com/pythonaisolutions/agentic-cervical-screener.git"
      path            = "deploy/k8s/production"
      target_revision = "main"
    }
    destination = {
      namespace = "production"
    }
    sync_policy = {
      automated = {
        prune     = true
        self_heal = true
      }
    }
  }

  cervical_viewer_staging = {
    project = "platform"
    source = {
      repo_url        = "https://github.com/pythonaisolutions/agentic-cervical-screener.git"
      path            = "deploy/k8s/staging"
      target_revision = "main"
    }
    destination = {
      namespace = "staging"
    }
    sync_policy = {
      automated = {
        prune     = true
        self_heal = true
      }
    }
  }
}
