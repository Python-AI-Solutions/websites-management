# Terraform files
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Service account keys - NEVER commit these!
*-key.json
*.json

# Local terraform variables
terraform.tfvars
*.auto.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
