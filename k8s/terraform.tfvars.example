# Terraform Configuration Example
# Copy this file to terraform.tfvars and fill in your own values
# DO NOT COMMIT terraform.tfvars to version control

# WireGuard private keys (base64 encoded, 32 bytes)
# Generate with: wg genkey | wg pubkey
debian_wireguard_private_key  = "YOUR_DEBIAN_WIREGUARD_PRIVATE_KEY_HERE"
bastion_wireguard_private_key = "YOUR_BASTION_WIREGUARD_PRIVATE_KEY_HERE"
bastion_wireguard_public_key  = "YOUR_BASTION_WIREGUARD_PUBLIC_KEY_HERE"

# FRP (Fast Reverse Proxy) authentication token
# Used for emergency access tunnel
frp_token = "YOUR_FRP_AUTH_TOKEN_HERE"

# Jump host (bastion) configuration
jump_host_jump_user             = "YOUR_JUMP_USER_NAME"
jump_host_jump_user_public_key  = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIxxxxxxxxxxxxxx user@host"
jump_host_admin_authorized_key  = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIyyyyyyyyyyyyyyyy user@host"
jump_host_key_name              = "YOUR_AWS_KEY_PAIR_NAME"

# CIDR blocks allowed to bootstrap/deploy infrastructure
# These are source IPs for Terraform deployment
jump_host_bootstrap_ssh_cidrs   = ["YOUR_IP_ADDRESS/32", "ANOTHER_IP/32"]

# CIDR blocks allowed to access FRP ports (emergency access)
# Leave empty if FRP is disabled
jump_host_port_7005_cidrs       = ["YOUR_IP_ADDRESS/32"]
jump_host_port_7006_cidrs       = ["YOUR_IP_ADDRESS/32"]

# WireGuard peer configuration
# Public keys for all clients that should access the cluster
wireguard_peers = [
  {
    name                 = "debian-host"
    public_key           = "DEBIAN_WIREGUARD_PUBLIC_KEY"
    allowed_ips          = ["10.99.0.2/32"]
    persistent_keepalive = 25
  },
  {
    name                 = "your-laptop"
    public_key           = "YOUR_LAPTOP_WIREGUARD_PUBLIC_KEY"
    allowed_ips          = ["10.99.0.15/32"]
    persistent_keepalive = 25
  },
  {
    name                 = "colleague-laptop"
    public_key           = "COLLEAGUE_WIREGUARD_PUBLIC_KEY"
    allowed_ips          = ["10.99.0.10/32"]
    persistent_keepalive = 25
  }
]

# Kubernetes control plane endpoint
# Format: INTERNAL_IP:6443
control_plane_endpoint = "10.99.0.2:6443"

# Bastion SSH user
bastion_ssh_user = "YOUR_JUMP_USER_NAME"

# AWS KMS key for Kubernetes node root volume encryption
jump_host_root_volume_kms_key_id = "arn:aws:kms:YOUR_REGION:YOUR_ACCOUNT_ID:key/YOUR_KEY_ID"

# Traefik ingress hostnames (override code defaults)
traefik_prod_host    = "cervical-screening.example.com"
traefik_staging_host = "staging.cervical-screening.example.com"
traefik_mlflow_host  = "mlflow.cervical-screening.example.com"

# MLflow configuration (override code defaults)
mlflow_host            = "mlflow.cervical-screening.example.com"
mlflow_artifact_bucket = "gs://YOUR_GCP_PROJECT-mlflow-artifacts/mlflow"

# Feature flags
enable_frp_emergency      = true
deploy_debian_host        = true
deploy_kubernetes_cluster = true
