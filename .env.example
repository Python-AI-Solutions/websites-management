# Cloudflare API token with DNS edit permissions on pythonaisolutions.com
CLOUDFLARE_API_TOKEN=

# Cloudflare account identifier (optional but enables additional providers)
CLOUDFLARE_ACCOUNT_ID=

# Default workspace variables exposed to OpenTofu
TF_VAR_zone_name=pythonaisolutions.com
TF_VAR_dmarc_rua=mailto:dmarc@pythonaisolutions.com
TF_VAR_dmarc_ruf=
TF_VAR_dmarc_policy=quarantine
TF_VAR_spf_txt=v=spf1 include:_spf.google.com ~all
