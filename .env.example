# Cloudflare API token with DNS edit permissions on example.com
CLOUDFLARE_API_TOKEN=

# Cloudflare account identifier (optional but enables additional providers)
CLOUDFLARE_ACCOUNT_ID=

# Default workspace variables exposed to OpenTofu
# Replace example.com with your actual domain
TF_VAR_zone_name=example.com
TF_VAR_dmarc_rua=mailto:dmarc@example.com
TF_VAR_dmarc_ruf=
TF_VAR_dmarc_policy=quarantine
TF_VAR_spf_txt=v=spf1 include:_spf.google.com ~all
